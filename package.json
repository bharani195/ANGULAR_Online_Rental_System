{
  "name": "angular-online-rental-system",
  "version": "1.0.0",
  "description": "MEAN stack Online Rental System for bikes, cars, books, and rooms",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/server.js",
    "client": "cd client && ng serve --port 4200",
    "build": "cd client && ng build",
    "test": "cd client && ng test",
    "seed": "node server/config/seed.js",
    "install-client": "cd client && npm install",
    "install-server": "npm install",
    "install-all": "npm run install-server && npm run install-client",
    "postinstall": "npm run install-client"
  },
  "keywords": ["angular", "nodejs", "express", "mongodb", "rental", "booking"],
  "author": "bharani195",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.0",
    "mongoose": "^7.0.0",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "dotenv": "^16.0.0",
    "multer": "^1.4.4",
    "express-validator": "^6.14.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.15",
    "concurrently": "^7.6.0"
  }
}